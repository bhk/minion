Variants.all = debug fast small

sizes = Sizes(CExe@sources)
all-sizes = Variants(Alias(sizes))
default = Alias(sizes)

sources = hello.c binsort.c

CC.inherit = CC-$V _CC

CC-debug.objFlags = -g
CC-fast.objFlags = -O3
CC-small.objFlags = -Os

Sizes.inherit = Run
Sizes.command = wc -c {^}

include ../minion.mk
